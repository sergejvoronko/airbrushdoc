---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import FAQ from '../components/FAQ.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroImageAlt?: string;
  category?: string;
  tags?: string[];
  readingTime?: number;
  slug: string;
  faqs?: { q: string; a: string }[];
  headings?: { depth: number; slug: string; text: string }[];
  hasAffiliate?: boolean;
}

const {
  title, description, pubDate, updatedDate,
  heroImage, heroImageAlt, category = 'general',
  tags = [], readingTime, slug, faqs = [], headings = [],
  hasAffiliate = false,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const formattedUpdated = updatedDate?.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const pageUrl = `https://airbrushdoc.com/blog/${slug}/`;
const CAT_LABELS: Record<string, string> = {
  'airbrush-reviews': 'Reviews',
  'beginners': 'Beginners',
  'discussion': 'Discussion',
  'download': 'Downloads',
  'gallery': 'Gallery',
  'guides': 'Guides',
  'history': 'History',
  'tipstricks': 'Tips & Tricks',
  'video': 'Video',
};
const categoryLabel = CAT_LABELS[category] ?? (category.charAt(0).toUpperCase() + category.slice(1).replace(/-/g, ' '));

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "url": pageUrl,
  "datePublished": pubDate.toISOString(),
  ...(updatedDate && { "dateModified": updatedDate.toISOString() }),
  "author": { "@type": "Person", "name": "AirbrushDOC", "url": "https://airbrushdoc.com/about/" },
  "publisher": {
    "@type": "Organization",
    "name": "AirbrushDOC",
    "url": "https://airbrushdoc.com",
    "logo": { "@type": "ImageObject", "url": "https://airbrushdoc.com/images/airbrushdoc-logo.webp" }
  },
  ...(heroImage && { "image": { "@type": "ImageObject", "url": `https://airbrushdoc.com${heroImage}`, "alt": heroImageAlt || title } }),
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://airbrushdoc.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://airbrushdoc.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": title, "item": pageUrl },
  ],
};

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
} : null;
---
<BaseLayout
  title={`${title} | AirbrushDOC`}
  description={description}
  image={heroImage}
  canonicalURL={pageUrl}
  ogType="article"
  ogArticlePubDate={pubDate.toISOString()}
  ogArticleModDate={updatedDate?.toISOString()}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />}

  <div class="abd-reading-progress" aria-hidden="true">
    <div class="abd-reading-progress-fill" id="readingProgress"></div>
  </div>

  <div class="abd-post-main">
    <div class="abd-post-wrap">
      <article class="abd-post-content">

        <header class="abd-post-header">
          <div class="abd-post-header-top">
            <a href={`/${category}/`} class="abd-category-badge">{categoryLabel}</a>
          </div>
          <h1 class="abd-post-title">{title}</h1>
          <div class="abd-meta-row">
            <span class="abd-meta-item">
              <svg class="abd-meta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            </span>
            {updatedDate && (
              <span class="abd-meta-item">
                <span>Updated {formattedUpdated}</span>
              </span>
            )}
            {readingTime && (
              <>
                <span class="abd-meta-sep"></span>
                <span class="abd-meta-item">
                  <svg class="abd-meta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  {readingTime} min read
                </span>
              </>
            )}
          </div>
        </header>

        {heroImage && (
          <div class="abd-post-hero">
            <img src={heroImage} alt={heroImageAlt || title} loading="eager" />
          </div>
        )}

        {hasAffiliate && (
          <div class="abd-affiliate-notice">
            <svg class="abd-affiliate-notice-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>This article contains affiliate links. If you buy through them, we may earn a small commission at no extra cost to you. <a href="/affiliate-disclosure/">Learn more</a>.</span>
          </div>
        )}

        <div class="abd-content">
          <slot />
        </div>

        {faqs.length > 0 && <FAQ faqs={faqs} />}

        <div class="abd-author-bio">
          <div class="abd-author-bio-avatar"><img src="/images/airbrushdoc-avatar.webp" alt="AirbrushDOC" width="72" height="72" /></div>
          <div class="abd-author-bio-info">
            <div class="abd-author-bio-label">Written by</div>
            <div class="abd-author-bio-name"><a href="/about/" class="abd-author-name-link">AirbrushDOC</a></div>
            <p class="abd-author-bio-text">Airbrush artist and educator sharing practical techniques, honest equipment reviews, and step-by-step guides for artists at every level.</p>
          </div>
        </div>

        <RelatedPosts currentSlug={slug} currentTags={tags} currentCategory={category} />

        <div class="abd-newsletter">
          <div class="abd-newsletter-inner">
            <div class="abd-newsletter-title">New guides, reviews and techniques</div>
            <p class="abd-newsletter-text">Get notified when new content is published — no spam, unsubscribe any time.</p>
            <div class="ml-embedded" data-form="d5CS8H"></div>
          </div>
        </div>

        <div class="abd-comments">
          <div class="abd-comments-title">Comments</div>
          <div id="remark42"></div>
          <script is:inline>
            var remark_config = {
              host:       "https://comments.airbrushdoc.com",
              site_id:    "airbrushdoc",
              components: ["embed"],
              theme:      "dark",
              locale:     "en",
              show_rss_subscription: false,
            };
            (function(c) {
              for (var i = 0; i < c.length; i++) {
                var d = document, s = d.createElement("script");
                s.src = remark_config.host + "/web/" + c[i] + ".js";
                s.defer = true;
                (d.head || d.body).appendChild(s);
              }
            })(remark_config.components || ["embed"]);
          </script>
        </div>

      </article>

      <aside class="abd-post-sidebar">
        {headings.length > 0 && <TOC headings={headings} />}

        <div class="abd-sidebar-widget">
          <div class="abd-share-sidebar">
            <div class="abd-share-label">Share</div>
            <div class="abd-share-icons">
              <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(title)}`}
                 class="abd-share-btn" target="_blank" rel="noopener" aria-label="Share on X">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`}
                 class="abd-share-btn" target="_blank" rel="noopener" aria-label="Share on Facebook">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <button class="abd-share-btn" id="copyLink" aria-label="Copy link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              </button>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <div class="abd-lightbox" id="abdLightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="abd-lightbox-close" id="abdLightboxClose" aria-label="Close">&#x2715;</button>
    <button class="abd-lightbox-prev" id="abdLightboxPrev" aria-label="Previous image">&#x2039;</button>
    <img class="abd-lightbox-img" id="abdLightboxImg" src="" alt="" />
    <button class="abd-lightbox-next" id="abdLightboxNext" aria-label="Next image">&#x203a;</button>
  </div>

  <script>
    // Reading progress
    const fill = document.getElementById('readingProgress');
    if (fill) {
      const update = () => {
        const el = document.documentElement;
        const pct = el.scrollTop / (el.scrollHeight - el.clientHeight) * 100;
        fill.style.width = Math.min(pct, 100) + '%';
      };
      window.addEventListener('scroll', update, { passive: true });
    }

    // Copy link
    document.getElementById('copyLink')?.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);
    });

    // TOC active state
    const tocLinks = document.querySelectorAll('.abd-toc-list a');
    const headings = document.querySelectorAll('.abd-content h2, .abd-content h3');
    if (tocLinks.length && headings.length) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocLinks.forEach(l => l.classList.remove('active'));
            const link = document.querySelector(`.abd-toc-list a[href="#${entry.target.id}"]`);
            link?.classList.add('active');
          }
        });
      }, { rootMargin: '-80px 0px -60% 0px' });
      headings.forEach(h => observer.observe(h));
    }

    // FAQ accordion
    document.querySelectorAll('.abd-faq-q').forEach(q => {
      q.addEventListener('click', () => {
        const item = q.closest('.abd-faq-item');
        item?.classList.toggle('abd-open');
      });
    });

    // Lightbox
    (() => {
      const lb    = document.getElementById('abdLightbox');
      const lbImg = document.getElementById('abdLightboxImg') as HTMLImageElement;
      const lbClose = document.getElementById('abdLightboxClose');
      const lbPrev  = document.getElementById('abdLightboxPrev');
      const lbNext  = document.getElementById('abdLightboxNext');
      if (!lb || !lbImg) return;

      let images: string[] = [];
      let current = 0;

      function open(srcs: string[], index: number) {
        images  = srcs;
        current = index;
        lbImg.src = images[current];
        lb.classList.add('open');
        document.body.style.overflow = 'hidden';
        const multi = images.length > 1;
        lbPrev!.style.display = multi ? '' : 'none';
        lbNext!.style.display = multi ? '' : 'none';
      }

      function close() {
        lb.classList.remove('open');
        document.body.style.overflow = '';
        lbImg.src = '';
      }

      function go(delta: number) {
        current = (current + delta + images.length) % images.length;
        lbImg.src = images[current];
      }

      // Gallery items — each gallery is its own navigation set
      document.querySelectorAll('.abd-gallery').forEach(gallery => {
        const imgs = Array.from(gallery.querySelectorAll<HTMLImageElement>('.abd-gallery-item img'));
        const srcs = imgs.map(i => i.src);
        imgs.forEach((img, idx) => {
          img.closest('.abd-gallery-item')!.addEventListener('click', () => open(srcs, idx));
        });
      });

      // Single content images (not inside a gallery)
      document.querySelectorAll<HTMLImageElement>('.abd-content img').forEach(img => {
        if (img.closest('.abd-gallery')) return;
        img.addEventListener('click', () => open([img.src], 0));
      });

      lbClose!.addEventListener('click', close);
      lbPrev!.addEventListener('click', () => go(-1));
      lbNext!.addEventListener('click', () => go(1));
      lb.addEventListener('click', e => { if (e.target === lb) close(); });

      document.addEventListener('keydown', e => {
        if (!lb.classList.contains('open')) return;
        if (e.key === 'Escape')     close();
        if (e.key === 'ArrowLeft')  go(-1);
        if (e.key === 'ArrowRight') go(1);
      });

      document.querySelectorAll('.abd-content table td').forEach(td => {
        if (td.textContent && td.textContent.includes('★'))
          td.innerHTML = td.innerHTML.replace(/★/g, '<span class="star-gold">★</span>');
      });
    })();
  </script>
</BaseLayout>
