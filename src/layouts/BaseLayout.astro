---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  ogType?: string;
  ogArticlePubDate?: string;
  ogArticleModDate?: string;
  bare?: boolean;     // hide header/footer/cookie (immersive full-screen pages)
  noindex?: boolean;  // emit robots noindex,nofollow
}

const { title, description = 'The Airbrush Doc — Cures for Your Canvas. Guides, reviews, and techniques for airbrush artists.', image, canonicalURL, ogType = 'website', ogArticlePubDate, ogArticleModDate, bare = false, noindex = false } = Astro.props;
const siteUrl = 'https://airbrushdoc.com';
const ogImage = image || '/images/og-default.webp';
const canonical = canonicalURL || new URL(Astro.url.pathname, siteUrl).href;

const nav = [
  { label: 'Blog',     href: '/blog/' },
  { label: 'Guides',   href: '/guides/' },
  { label: 'Tools',    href: '/tools/' },
  { label: 'Freebies', href: '/freebies/' },
  { label: 'About',    href: '/about/' },
  { label: 'Book',     href: '/book/', highlight: true },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  {ogArticlePubDate && <meta property="article:published_time" content={ogArticlePubDate} />}
  {ogArticleModDate && <meta property="article:modified_time" content={ogArticleModDate} />}
  {ogType === 'article' && <meta property="article:author" content="AirbrushDOC" />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Fonts self-hosted (declared in global.css) — preload latin variants used above the fold -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/outfit-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin />

  <slot name="head" />

  <!-- MailerLite Universal — lazy-loaded (off the critical path: improves TTI,
       drops third-party legacy-JS / network-chain / cache warnings). Loads when a
       form nears the viewport, on first interaction, or on idle (fallback). -->
  <script is:inline>
    (function(){
      var loaded = false;
      function loadML(){
        if (loaded) return; loaded = true;
        window.ml = window.ml || function(){ (window.ml.q = window.ml.q || []).push(arguments); };
        ml('account', '1137328');
        var s = document.createElement('script');
        s.async = 1; s.src = 'https://assets.mailerlite.com/js/universal.js';
        document.head.appendChild(s);
      }
      function watch(){
        var forms = document.querySelectorAll('.ml-embedded');
        if (forms.length && 'IntersectionObserver' in window){
          var io = new IntersectionObserver(function(es){
            es.forEach(function(e){ if (e.isIntersecting){ loadML(); io.disconnect(); } });
          }, { rootMargin: '600px' });
          forms.forEach(function(f){ io.observe(f); });
        } else if (forms.length){ loadML(); }
      }
      // Load when a form nears the viewport (IO, 600px pre-margin) or on first
      // interaction. No idle/timeout fallback — forms are below the fold, so any
      // path that reaches one already triggers a load; keeps it off the lab critical path.
      document.addEventListener('DOMContentLoaded', watch);
      ['scroll','pointerdown','keydown','touchstart'].forEach(function(ev){
        window.addEventListener(ev, loadML, { once: true, passive: true });
      });
    })();
  </script>

  <!-- a11y: MailerLite injects an ID-scoped !important rule that paints the submit
       button #F4671A (white text = 3.08:1, fails WCAG AA). Inline !important is the
       only thing that outranks it; observer reapplies on (re)render. -->
  <script is:inline>
    (function(){
      function fix(){
        document.querySelectorAll('.ml-embedded button[type="submit"]').forEach(function(b){
          if(b.dataset.ctaFixed)return;
          b.style.setProperty('background','#C45010','important');
          b.dataset.ctaFixed='1';
        });
      }
      new MutationObserver(fix).observe(document.documentElement,{childList:true,subtree:true});
      document.addEventListener('DOMContentLoaded',fix);
    })();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "AirbrushDOC",
    "url": "https://airbrushdoc.com",
    "description": "Expert airbrush guides, honest equipment reviews, step-by-step tutorials, and free stencils for artists at every level.",
    "publisher": { "@id": "https://airbrushdoc.com/#organization" },
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "https://airbrushdoc.com/blog/?q={search_term_string}" },
      "query-input": "required name=search_term_string"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://airbrushdoc.com/#organization",
    "name": "AirbrushDOC",
    "url": "https://airbrushdoc.com",
    "description": "Cures for Your Canvas. Practical airbrush guides, honest equipment reviews, and techniques for artists at every level.",
    "logo": {
      "@type": "ImageObject",
      "url": "https://airbrushdoc.com/images/airbrushdoc-logo.webp",
      "width": 157,
      "height": 120
    },
    "sameAs": [
      "https://www.facebook.com/airbrushdoc",
      "https://www.instagram.com/airbrushdoc_er",
      "https://www.pinterest.com/airbrushdoc",
      "https://t.me/airbrushdoc"
    ]
  })} />
</head>
<body>
  <a href="#main-content" class="abd-skip-link">Skip to main content</a>
  {!bare && (<>
  <div class="abd-top-bar"></div>

  <header class="abd-header">
    <div class="abd-header-inner">
      <a href="/" class="abd-logo" aria-label="AirbrushDOC home">
        <img src="/images/airbrushdoc-logo.webp" alt="AirbrushDOC" class="abd-logo-img" width="157" height="120" fetchpriority="high" />
      </a>

      <nav class="abd-nav" aria-label="Main navigation">
        {nav.map(n => (
          <a href={n.href}
             class={n.highlight ? 'abd-nav-book' : undefined}
             aria-current={Astro.url.pathname.startsWith(n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        ))}
      </nav>

      <button class="abd-menu-toggle" aria-label="Toggle menu" aria-expanded="false" id="menuToggle">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>

    <nav class="abd-mobile-nav" id="mobileNav" aria-label="Mobile navigation">
      {nav.map(n => <a href={n.href}>{n.label}</a>)}
    </nav>
  </header>
  </>)}

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  {!bare && (
  <footer class="abd-footer">
    <div class="abd-footer-inner">
      <div class="abd-footer-brand">
        <img src="/images/footer-badge.webp" alt="AirbrushDOC — Cures for Your Canvas" class="abd-footer-badge" width="220" height="188" loading="lazy" decoding="async" />
        <p class="abd-footer-tagline">Practical guides, honest reviews, and techniques for airbrush artists at every level.</p>
      </div>
      <div class="abd-footer-col">
        <p class="abd-footer-col-heading">Content</p>
        <ul>
          <li><a href="/blog/">All Articles</a></li>
          <li><a href="/beginners/">Beginner Articles</a></li>
          <li><a href="/airbrush-glossary/">Glossary</a></li>
          <li><a href="/tools/">Interactive Tools</a></li>
        </ul>
      </div>
      <div class="abd-footer-col">
        <p class="abd-footer-col-heading">Site</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/affiliate-disclosure/">Disclosure</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div class="abd-footer-col">
        <p class="abd-footer-col-heading">Follow</p>
        <ul class="abd-footer-social">
          <li><a href="https://www.facebook.com/airbrushdoc" rel="me noopener" target="_blank" aria-label="AirbrushDOC on Facebook" title="Facebook">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.5-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z"/></svg>
          </a></li>
          <li><a href="https://www.instagram.com/airbrushdoc_er" rel="me noopener" target="_blank" aria-label="AirbrushDOC on Instagram" title="Instagram">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.5" y="2.5" width="19" height="19" rx="5.2"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r="1.15" fill="currentColor" stroke="none"/></svg>
          </a></li>
          <li><a href="https://www.pinterest.com/airbrushdoc" rel="me noopener" target="_blank" aria-label="AirbrushDOC on Pinterest" title="Pinterest">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.64 7.86 6.36 9.32-.09-.79-.17-2.01.03-2.88.18-.78 1.19-4.97 1.19-4.97s-.3-.61-.3-1.51c0-1.42.82-2.48 1.85-2.48.87 0 1.29.66 1.29 1.44 0 .88-.56 2.19-.85 3.41-.24 1.02.51 1.85 1.52 1.85 1.83 0 3.23-1.93 3.23-4.71 0-2.46-1.77-4.18-4.29-4.18-2.92 0-4.64 2.19-4.64 4.46 0 .88.34 1.83.76 2.34.08.1.1.19.07.29-.08.32-.25.98-.28 1.12-.05.19-.15.23-.35.14-1.3-.61-2.11-2.5-2.11-4.03 0-3.28 2.38-6.29 6.87-6.29 3.61 0 6.41 2.57 6.41 6.005 0 3.58-2.26 6.47-5.4 6.47-1.05 0-2.04-.55-2.38-1.2l-.65 2.47c-.23.9-.86 2.03-1.28 2.72.96.3 1.98.46 3.04.46 5.52 0 10-4.48 10-10S17.52 2 12 2Z"/></svg>
          </a></li>
          <li><a href="https://t.me/airbrushdoc" rel="me noopener" target="_blank" aria-label="AirbrushDOC on Telegram" title="Telegram">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false"><path d="M21.94 4.6 18.9 19.1c-.23 1.02-.84 1.27-1.7.79l-4.7-3.46-2.27 2.18c-.25.25-.46.46-.94.46l.33-4.78 8.7-7.86c.38-.34-.08-.53-.59-.19L6.08 13.02l-4.63-1.45c-1.01-.32-1.03-1.01.21-1.5l18.1-6.98c.84-.31 1.57.19 1.3 1.5Z"/></svg>
          </a></li>
        </ul>
      </div>
    </div>
    <div class="abd-footer-bottom">
      <span>© {new Date().getFullYear()} AirbrushDOC. All rights reserved.</span>
      <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
    </div>
  </footer>
  )}

  {!bare && <CookieBanner />}

  <script>
    const toggle = document.getElementById('menuToggle');
    const nav = document.getElementById('mobileNav');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('abd-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  </script>
</body>
</html>
