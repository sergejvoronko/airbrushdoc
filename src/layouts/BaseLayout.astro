---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  ogType?: string;
  ogArticlePubDate?: string;
  ogArticleModDate?: string;
}

const { title, description = 'The Airbrush Doc — Cures for Your Canvas. Guides, reviews, and techniques for airbrush artists.', image, canonicalURL, ogType = 'website', ogArticlePubDate, ogArticleModDate } = Astro.props;
const siteUrl = 'https://airbrushdoc.com';
const ogImage = image || '/images/og-default.webp';
const canonical = canonicalURL || new URL(Astro.url.pathname, siteUrl).href;

const nav = [
  { label: 'Blog',     href: '/blog/' },
  { label: 'Guides',   href: '/guides/' },
  { label: 'Tools',    href: '/tools/' },
  { label: 'Freebies', href: '/freebies/' },
  { label: 'About',    href: '/about/' },
  { label: 'Book',     href: '/book/', highlight: true },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  {ogArticlePubDate && <meta property="article:published_time" content={ogArticlePubDate} />}
  {ogArticleModDate && <meta property="article:modified_time" content={ogArticleModDate} />}
  {ogType === 'article' && <meta property="article:author" content="AirbrushDOC" />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Fonts async — eliminates render-blocking Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;0,9..144,800;1,9..144,400&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;0,9..144,800;1,9..144,400&display=swap" /></noscript>

  <slot name="head" />

  <!-- MailerLite Universal — lazy-loaded (off the critical path: improves TTI,
       drops third-party legacy-JS / network-chain / cache warnings). Loads when a
       form nears the viewport, on first interaction, or on idle (fallback). -->
  <script is:inline>
    (function(){
      var loaded = false;
      function loadML(){
        if (loaded) return; loaded = true;
        window.ml = window.ml || function(){ (window.ml.q = window.ml.q || []).push(arguments); };
        ml('account', '1137328');
        var s = document.createElement('script');
        s.async = 1; s.src = 'https://assets.mailerlite.com/js/universal.js';
        document.head.appendChild(s);
      }
      function watch(){
        var forms = document.querySelectorAll('.ml-embedded');
        if (forms.length && 'IntersectionObserver' in window){
          var io = new IntersectionObserver(function(es){
            es.forEach(function(e){ if (e.isIntersecting){ loadML(); io.disconnect(); } });
          }, { rootMargin: '600px' });
          forms.forEach(function(f){ io.observe(f); });
        } else if (forms.length){ loadML(); }
      }
      // Load when a form nears the viewport (IO, 600px pre-margin) or on first
      // interaction. No idle/timeout fallback — forms are below the fold, so any
      // path that reaches one already triggers a load; keeps it off the lab critical path.
      document.addEventListener('DOMContentLoaded', watch);
      ['scroll','pointerdown','keydown','touchstart'].forEach(function(ev){
        window.addEventListener(ev, loadML, { once: true, passive: true });
      });
    })();
  </script>

  <!-- a11y: MailerLite injects an ID-scoped !important rule that paints the submit
       button #F4671A (white text = 3.08:1, fails WCAG AA). Inline !important is the
       only thing that outranks it; observer reapplies on (re)render. -->
  <script is:inline>
    (function(){
      function fix(){
        document.querySelectorAll('.ml-embedded button[type="submit"]').forEach(function(b){
          if(b.dataset.ctaFixed)return;
          b.style.setProperty('background','#C45010','important');
          b.dataset.ctaFixed='1';
        });
      }
      new MutationObserver(fix).observe(document.documentElement,{childList:true,subtree:true});
      document.addEventListener('DOMContentLoaded',fix);
    })();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "AirbrushDOC",
    "url": "https://airbrushdoc.com",
    "description": "Expert airbrush guides, honest equipment reviews, step-by-step tutorials, and free stencils for artists at every level.",
    "publisher": { "@id": "https://airbrushdoc.com/#organization" },
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "https://airbrushdoc.com/blog/?q={search_term_string}" },
      "query-input": "required name=search_term_string"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://airbrushdoc.com/#organization",
    "name": "AirbrushDOC",
    "url": "https://airbrushdoc.com",
    "description": "Practical airbrush guides, honest equipment reviews, and techniques for artists at every level.",
    "logo": {
      "@type": "ImageObject",
      "url": "https://airbrushdoc.com/images/airbrushdoc-logo.webp",
      "width": 157,
      "height": 120
    }
  })} />
</head>
<body>
  <a href="#main-content" class="abd-skip-link">Skip to main content</a>
  <div class="abd-top-bar"></div>

  <header class="abd-header">
    <div class="abd-header-inner">
      <a href="/" class="abd-logo" aria-label="AirbrushDOC home">
        <img src="/images/airbrushdoc-logo.webp" alt="AirbrushDOC" class="abd-logo-img" width="157" height="120" fetchpriority="high" />
      </a>

      <nav class="abd-nav" aria-label="Main navigation">
        {nav.map(n => (
          <a href={n.href}
             class={n.highlight ? 'abd-nav-book' : undefined}
             aria-current={Astro.url.pathname.startsWith(n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        ))}
      </nav>

      <button class="abd-menu-toggle" aria-label="Toggle menu" aria-expanded="false" id="menuToggle">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>

    <nav class="abd-mobile-nav" id="mobileNav" aria-label="Mobile navigation">
      {nav.map(n => <a href={n.href}>{n.label}</a>)}
    </nav>
  </header>

  <div id="main-content" tabindex="-1">
    <slot />
  </div>

  <footer class="abd-footer">
    <div class="abd-footer-inner">
      <div class="abd-footer-brand">
        <div class="abd-footer-logo">Airbrush<span>DOC</span></div>
        <p class="abd-footer-tagline">Cures for Your Canvas. Practical guides, honest reviews, and techniques for airbrush artists at every level.</p>
      </div>
      <div class="abd-footer-col">
        <p class="abd-footer-col-heading">Content</p>
        <ul>
          <li><a href="/blog/">All Articles</a></li>
          <li><a href="/beginners/">Beginner Articles</a></li>
          <li><a href="/airbrush-glossary/">Glossary</a></li>
          <li><a href="/tools/">Interactive Tools</a></li>
        </ul>
      </div>
      <div class="abd-footer-col">
        <p class="abd-footer-col-heading">Site</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/affiliate-disclosure/">Disclosure</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="abd-footer-bottom">
      <span>© {new Date().getFullYear()} AirbrushDOC. All rights reserved.</span>
      <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
    </div>
  </footer>

  <CookieBanner />

  <script>
    const toggle = document.getElementById('menuToggle');
    const nav = document.getElementById('mobileNav');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('abd-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  </script>
</body>
</html>
