---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.pubDate <= new Date());
const recent = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const pinnedSlugs = ['best-airbrush-for-beginners-2026', 'advanced-guide-to-airbrush-colors', 'best-air-compressor'];
const pinnedPosts = pinnedSlugs.map(s => allPosts.find(p => p.id === s)).filter(Boolean);

const testimonials = [
  {
    text: "It is good that you took the time to post a comprehensive listing of paint options. I wish more websites did so. The mainstream airbrush sites are sorely lacking on this point. Thanks!",
    author: "Barry Munden",
    avatar: "/images/wp-uploads/barry1.webp",
  },
  {
    text: "One of the biggest things for me was having Walkup's 93 year old nephew tell me that he was so pleased that his family could now be recognized for all their efforts. History made real!! Keep up the good work.",
    author: "Andy Penaluna",
    avatar: "/images/wp-uploads/andy-penaluna-e1437996862989.webp",
  },
  {
    text: "This is my second time at your site. And now I realize you have designed a great site to study and learn from.",
    author: "Larry Potillo",
    avatar: "/images/wp-uploads/larry_potillo.webp",
  },
];

const featureSvgs = [
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
];
const features = [
  { icon: featureSvgs[0], title: "Equipment Reviews", text: "We've tested airbrushes from Iwata, Badger, Paasche, Harder & Steenbeck and more — honest, hands-on, no fluff.", href: "/airbrush-reviews/" },
  { icon: featureSvgs[1], title: "Step-by-Step Tutorials", text: "From basic techniques to advanced multi-layer work. Real projects, real photos, practical tips at every skill level.", href: "/beginners/" },
  { icon: featureSvgs[2], title: "Free Resources", text: "Subscribe and download skull stencils, fire reference packs, and mix stencil designs — free with your newsletter signup.", href: "/freebies/" },
];
---
<BaseLayout
  title="AirbrushDOC — Expert Airbrush Reviews, Tutorials &amp; Free Stencils"
  description="Master airbrushing with expert equipment reviews, step-by-step tutorials, and free downloadable stencils. For beginners and professionals since 2010."
>
  <link slot="head" rel="preload" as="image" href="/images/airbrushdoc.webp" imagesrcset="/images/airbrushdoc-mobile.webp 900w, /images/airbrushdoc.webp 1536w" imagesizes="100vw" fetchpriority="high" />

  <!-- ═══ HERO ═══ -->
  <section class="abd-hero-full">
    <img class="abd-hero-full-bg" src="/images/airbrushdoc.webp" srcset="/images/airbrushdoc-mobile.webp 900w, /images/airbrushdoc.webp 1536w" sizes="100vw" alt="" aria-hidden="true" fetchpriority="high" decoding="async" width="1536" height="1024" />
    <div class="abd-hero-full-overlay"></div>
    <div class="abd-hero-full-content">
      <div class="abd-hero-left">
        <div class="abd-hero-eyebrow">✦ Trusted by 5,000+ readers &amp; followers since 2010</div>
        <h1 class="abd-hero-full-title">
          Master Airbrush Art<br /><span class="abd-hero-title-accent">From Beginner to Pro</span>
        </h1>
      </div>
      <div class="abd-hero-right">
        <p class="abd-hero-full-subtitle">
          Expert equipment reviews, step-by-step tutorials, and free stencils to level up your airbrush game — whatever your skill level or budget.
        </p>
        <div class="abd-hero-ctas">
          <a href="/blog/" class="abd-btn-primary">Browse Articles</a>
          <a href="/tools/airbrush-quiz/" class="abd-btn-ghost" style="border-color: rgba(255,255,255,0.3); color: #fff;">Find Your Airbrush →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ STATS STRIP ═══ -->
  <section class="abd-stats-strip">
    <div class="abd-stats-inner">
      <div class="abd-stat">
        <span class="abd-stat-num">15+</span>
        <span class="abd-stat-label">Years Publishing</span>
      </div>
      <div class="abd-stat-sep"></div>
      <div class="abd-stat">
        <span class="abd-stat-num">100+</span>
        <span class="abd-stat-label">In-Depth Articles</span>
      </div>
      <div class="abd-stat-sep"></div>
      <div class="abd-stat">
        <span class="abd-stat-num">5,000+</span>
        <span class="abd-stat-label">Followers &amp; Subscribers</span>
      </div>
      <div class="abd-stat-sep"></div>
      <div class="abd-stat">
        <span class="abd-stat-num">Free</span>
        <span class="abd-stat-label">Stencils &amp; Tools</span>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT YOU'LL FIND ═══ -->
  <section class="abd-section">
    <div class="abd-section-header">
      <h2 class="abd-section-title">Everything You Need to Master Airbrushing</h2>
    </div>
    <div class="abd-features-grid">
      {features.map(f => (
        <a href={f.href} class="abd-feature-card">
          <div class="abd-feature-icon" set:html={f.icon}></div>
          <div class="abd-feature-name">{f.title}</div>
          <p class="abd-feature-desc">{f.text}</p>
          <span class="abd-feature-link">Learn more →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ START HERE — FEATURED GUIDES ═══ -->
  <section class="abd-section abd-pinned-section">
    <div class="abd-section-header">
      <div>
        <div class="abd-pinned-eyebrow">Start Here</div>
        <h2 class="abd-section-title">Essential Guides</h2>
      </div>
      <a href="/blog/" class="abd-section-link">All articles →</a>
    </div>
    <div class="abd-pinned-grid">
      {pinnedPosts.map((post, i) => {
        const labels = ['Beginner Pick', 'Paint Guide', 'Compressor Guide'];
        const colors = ['var(--abd-orange)', 'var(--abd-blue)', 'var(--abd-green)'];
        return (
          <a href={`/blog/${post!.id}/`} class="abd-pinned-card">
            {post!.data.heroImage && (
              <div class="abd-pinned-img">
                <img
                  src={post!.data.heroImage?.endsWith('.webp') ? post!.data.heroImage.replace(/\.webp$/, '-thumb.webp') : post!.data.heroImage}
                  alt={post!.data.title} loading="lazy" width="360" height="203" />
              </div>
            )}
            <div class="abd-pinned-body">
              <span class="abd-pinned-badge" style={`color:${colors[i]};border-color:${colors[i]}22;background:${colors[i]}11`}>{labels[i]}</span>
              <div class="abd-pinned-title">{post!.data.title}</div>
              {post!.data.description && <p class="abd-pinned-desc">{post!.data.description}</p>}
              <span class="abd-pinned-cta">Read guide →</span>
            </div>
          </a>
        );
      })}
    </div>

    <div class="abd-resource-row">
      <a href="/tools/" class="abd-resource-card">
        <div class="abd-resource-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
        <div class="abd-resource-text">
          <div class="abd-resource-label">Interactive Tools</div>
          <div class="abd-resource-desc">Airbrush finder quiz, troubleshooter, paint selector, and model comparison — 4 free tools.</div>
        </div>
        <span class="abd-resource-cta">Explore tools →</span>
      </a>
      <a href="/airbrush-glossary/" class="abd-resource-card">
        <div class="abd-resource-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
        <div class="abd-resource-text">
          <div class="abd-resource-label">Airbrush Glossary</div>
          <div class="abd-resource-desc">55 terms explained A–Z — from air pressure to viscosity. The reference every airbrush artist needs.</div>
        </div>
        <span class="abd-resource-cta">Browse glossary →</span>
      </a>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="abd-testimonials-section">
    <div class="abd-container">
      <div class="abd-section-header" style="margin-bottom: 32px;">
        <h2 class="abd-section-title">What Artists Are Saying</h2>
      </div>
      <div class="abd-testi-grid">
        {testimonials.map(t => (
          <div class="abd-testi-card">
            <div class="abd-testi-stars">★★★★★</div>
            <p class="abd-testi-text">"{t.text}"</p>
            <div class="abd-testi-author">
              <div class="abd-testi-avatar">
                <img src={t.avatar} alt={t.author} loading="lazy"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                <div class="abd-testi-avatar-fallback">{t.author[0]}</div>
              </div>
              <span class="abd-testi-name">{t.author}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TOOLS ═══ -->
  <section class="abd-section" style="border-top: 1px solid var(--abd-border);">
    <div class="abd-section-header">
      <h2 class="abd-section-title">Interactive Tools</h2>
      <a href="/tools/" class="abd-section-link">All tools →</a>
    </div>
    <div class="abd-tools-grid">
      <a href="/tools/airbrush-quiz/" class="abd-tool-card">
        <div class="abd-tool-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
        <div class="abd-tool-name">Airbrush Finder Quiz</div>
        <p class="abd-tool-desc">Answer 6 questions and get matched with the right airbrush for your style and budget.</p>
      </a>
      <a href="/tools/troubleshooter/" class="abd-tool-card">
        <div class="abd-tool-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
        <div class="abd-tool-name">Troubleshooter</div>
        <p class="abd-tool-desc">Diagnose spitting, clogging, and uneven spray problems step by step.</p>
      </a>
      <a href="/tools/paint-selector/" class="abd-tool-card">
        <div class="abd-tool-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg></div>
        <div class="abd-tool-name">Paint Selector</div>
        <p class="abd-tool-desc">Find the right paint for your surface and application type.</p>
      </a>
      <a href="/tools/compare/" class="abd-tool-card">
        <div class="abd-tool-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21H17"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg></div>
        <div class="abd-tool-name">Compare Airbrushes</div>
        <p class="abd-tool-desc">Side-by-side specs of popular airbrush models.</p>
      </a>
    </div>
    <div style="margin-top: 20px; padding: 16px 20px; background: var(--abd-surface); border: 1px solid var(--abd-border); border-radius: var(--abd-radius); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
      <div>
        <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--abd-text-muted);">Reference</span>
        <div style="font-size: 0.95rem; font-weight: 600; color: var(--abd-text); margin-top: 2px;">Airbrush Glossary — 55 terms explained A to Z</div>
      </div>
      <a href="/airbrush-glossary/" style="font-size: 0.85rem; font-weight: 600; color: var(--abd-orange); text-decoration: none; white-space: nowrap;">Browse Glossary →</a>
    </div>
  </section>

  <!-- ═══ LATEST ARTICLES ═══ -->
  <section class="abd-section" style="border-top: 1px solid var(--abd-border);">
    <div class="abd-section-header">
      <h2 class="abd-section-title">Latest Articles</h2>
      <a href="/blog/" class="abd-section-link">View all →</a>
    </div>
    <div class="home-articles-grid">
      {recent.map((post, i) => (
        <ArticleCard
          title={post.data.title}
          slug={post.id}
          description={post.data.description}
          heroImage={post.data.heroImage}
          heroImageAlt={post.data.heroImageAlt}
          category={post.data.category}
          pubDate={post.data.pubDate}
          readingTime={post.data.readingTime}
          featured={i === 0}
        />
      ))}
    </div>
  </section>

  <!-- ═══ BOOK PROMO ═══ -->
  <section class="abd-book-promo">
    <div class="abd-book-promo-inner">
      <div class="abd-book-promo-cover">
        <div class="abd-book-mini-spine"></div>
        <div class="abd-book-mini-front">
          <div class="abd-book-mini-title">The Airbrush<br/>Technique<br/>Bible</div>
          <div class="abd-book-mini-badge">17 Chapters</div>
        </div>
      </div>
      <div class="abd-book-promo-text">
        <div class="abd-book-promo-eyebrow">✦ New — Digital Edition</div>
        <h2 class="abd-book-promo-title">Stop watching tutorials.<br/><span style="color:var(--abd-orange);">Start understanding.</span></h2>
        <p class="abd-book-promo-desc">17 chapters covering every technique, surface, and style — from first spray to professional results. Includes the Troubleshooting Encyclopedia, a complete business guide, and the Stencil Creator tool free as a bonus.</p>
        <div class="abd-book-promo-actions">
          <a href="/book/" class="abd-btn-primary">Get the Book — $27</a>
          <a href="/book/preview/" class="abd-book-promo-preview">Read free preview →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SEO CONTENT ═══ -->
  <section class="abd-section">
    <div style="max-width: var(--abd-content-w); margin: 0 auto;">
      <h2 style="font-family: var(--abd-font-display); font-size: clamp(1.4rem,3vw,1.8rem); font-weight: 700; color: var(--abd-text); margin-bottom: 20px; padding-left: 16px; position: relative;">
        <span style="position:absolute;left:0;top:4px;width:3px;height:calc(100% - 8px);background:var(--abd-orange);border-radius:2px;"></span>
        What You'll Find at AirbrushDOC
      </h2>
      <p style="color: var(--abd-text-dim); font-size: 1rem; line-height: 1.8; margin-bottom: 24px;">
        Whether you're just getting started or a seasoned professional looking to refine your technique, AirbrushDOC is your complete resource for everything airbrush. We've created comprehensive guides, honest reviews, and free resources to help you master this versatile art form.
      </p>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
        <div style="background: var(--abd-surface); border: 1px solid var(--abd-border); border-radius: var(--abd-radius); padding: 20px;">
          <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--abd-orange); margin-bottom: 12px;">For Beginners</div>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 7px;">
            {['Step-by-step tutorials for basic techniques', 'Equipment buying guides under €100', 'Free single-layer stencils to practice', 'Paint thinning and mixing guides', 'Common troubleshooting solutions'].map(i => (
              <li style="font-size: 0.875rem; color: var(--abd-text-dim); display: flex; gap: 8px;">
                <span style="color: var(--abd-orange); flex-shrink: 0;">→</span>{i}
              </li>
            ))}
          </ul>
        </div>
        <div style="background: var(--abd-surface); border: 1px solid var(--abd-border); border-radius: var(--abd-radius); padding: 20px;">
          <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--abd-orange); margin-bottom: 12px;">For Professionals</div>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 7px;">
            {['Advanced multi-layer stenciling techniques', 'Professional equipment comparisons', 'Premium mix stencil packs', 'Custom automotive finishing guides', 'Time-saving tips and workflow optimization'].map(i => (
              <li style="font-size: 0.875rem; color: var(--abd-text-dim); display: flex; gap: 8px;">
                <span style="color: var(--abd-orange); flex-shrink: 0;">→</span>{i}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <h3 style="font-family: var(--abd-font-display); font-size: 1.2rem; font-weight: 700; color: var(--abd-text); margin-bottom: 12px;">Comprehensive Airbrush Equipment Reviews</h3>
      <p style="color: var(--abd-text-dim); font-size: 0.95rem; line-height: 1.8; margin-bottom: 20px;">
        We've personally tested dozens of airbrushes, compressors, and paint systems from top brands including Iwata, Badger, Paasche, Harder &amp; Steenbeck, and Master Airbrush. Our reviews are unbiased and based on real-world performance, not manufacturer specifications.
      </p>

      <h3 style="font-family: var(--abd-font-display); font-size: 1.2rem; font-weight: 700; color: var(--abd-text); margin-bottom: 12px;">What Makes AirbrushDOC Different</h3>
      <p style="color: var(--abd-text-dim); font-size: 0.95rem; line-height: 1.8; margin-bottom: 12px;">
        We're not just another equipment review site. We're practicing airbrush artists who use these tools every day. Our founder has over 15 years of experience in custom automotive work, t-shirt design, and fine art airbrushing. Every review, tutorial, and stencil design comes from real hands-on experience.
      </p>
      <p style="color: var(--abd-text-dim); font-size: 0.95rem; line-height: 1.8;">
        Our mission: to make airbrushing accessible and enjoyable for everyone, regardless of skill level or budget. With the right guidance and tools, anyone can create stunning airbrush art.
      </p>
    </div>
  </section>

  <!-- ═══ NEWSLETTER ═══ -->
  <section style="background: var(--abd-surface); border-top: 1px solid var(--abd-border); padding: 64px 24px;">
    <div style="max-width: 560px; margin: 0 auto; text-align: center;">
      <div style="margin-bottom: 16px; color: var(--abd-orange);"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div>
      <h2 style="font-family: var(--abd-font-display); font-size: clamp(1.5rem,3vw,2rem); font-weight: 700; color: var(--abd-text); margin-bottom: 12px;">
        Free Downloads &amp; New Guides
      </h2>
      <p style="font-size: 0.95rem; color: var(--abd-text-dim); margin-bottom: 8px; line-height: 1.6;">
        Join 5,000+ subscribers and get instant access to free stencils, reference packs, and exclusive tools.
      </p>
      <ul style="list-style: none; margin-bottom: 28px; display: flex; flex-direction: column; gap: 6px; text-align: left; max-width: 280px; margin-left: auto; margin-right: auto;">
        {['Skull stencils + fire reference pack', 'Access to exclusive subscriber tools', 'New guides & equipment reviews'].map(item => (
          <li style="font-size: 0.85rem; color: var(--abd-text-dim); display: flex; align-items: center; gap: 8px;">
            <span style="color: var(--abd-green); font-weight: 700;">✓</span>{item}
          </li>
        ))}
      </ul>
      <div class="ml-embedded" data-form="d5CS8H"></div>
      <p style="font-size: 0.75rem; color: var(--abd-text-muted);">We respect your privacy. Unsubscribe anytime.</p>
    </div>
  </section>

</BaseLayout>

<style>
/* ═══ HERO FULL-WIDTH ═══ */
.abd-hero-full {
  position: relative;
  min-height: 560px;
