---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';

const tools = [
  {
    slug: 'airbrush-quiz',
    icon: '🎯',
    name: 'Airbrush Finder Quiz',
    desc: 'Answer 6 questions and get matched with the right airbrush for your style, surface, and budget.',
    time: '3 min',
  },
  {
    slug: 'paint-selector',
    icon: '🎨',
    name: 'Paint Selector',
    desc: 'Find the right paint type for your surface, finish, and application — airbrush-ready formulas only.',
    time: '2 min',
  },
  {
    slug: 'compare',
    icon: '⚖️',
    name: 'Compare Airbrushes',
    desc: 'Side-by-side specs comparison of popular airbrush models to make the buying decision easier.',
    time: '5 min',
  },
];

const subscriberTools = [
  {
    icon: '🔧',
    name: 'Airbrush Troubleshooter',
    desc: 'Diagnose spitting, clogging, uneven spray, and other common airbrush problems step by step.',
  },
  {
    icon: '🧪',
    name: 'AirMix Studio',
    desc: 'Paint ratio calculator, project logbook, needle & nozzle reference, and color harmony tool — all in one.',
  },
];
---
<BaseLayout title="Interactive Tools | AirbrushDOC" description="Free interactive airbrush tools — find the right airbrush, compare models, and choose paint. Troubleshooter & AirMix Studio for subscribers; Stencil Creator free with the book.">
  <main class="abd-container">
    <div class="blg-page-header">
      <nav class="blg-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="blg-breadcrumbs-sep">›</span>
        <span>Tools</span>
      </nav>
      <div class="blg-title-row">
        <h1 class="blg-page-title">Interactive <span class="blg-page-title-accent">Tools</span></h1>
        <span class="blg-post-count">{tools.length + subscriberTools.length + 1} tools</span>
      </div>
      <div class="blg-header-line"></div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; padding: 32px 0 0;">
      {tools.map(t => (
        <a href={`/tools/${t.slug}/`} class="abd-tool-card" style="padding: 28px 24px; gap: 16px;">
          <div style="font-size: 2rem;">{t.icon}</div>
          <div>
            <div class="abd-tool-name" style="font-size: 1.1rem; margin-bottom: 8px;">{t.name}</div>
            <p class="abd-tool-desc" style="font-size: 0.88rem; line-height: 1.6;">{t.desc}</p>
          </div>
          <div style="margin-top: auto; font-size: 0.75rem; color: var(--abd-text-muted); display: flex; align-items: center; gap: 6px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            {t.time}
          </div>
        </a>
      ))}
    </div>

    <div class="tools-subscriber-section">
      <div class="tools-sub-header">
        <div class="tools-sub-label">Subscriber Tools</div>
        <h2 class="tools-sub-title">2 more tools — free for subscribers</h2>
        <p class="tools-sub-desc">Subscribe to the newsletter and unlock the Airbrush Troubleshooter and AirMix Studio — plus all downloadable reference packs and stencils. No payment, just your email.</p>
      </div>

      <div class="tools-locked-grid">
        {subscriberTools.map(t => (
          <div class="tools-locked-card">
            <div class="tools-locked-icon">{t.icon}</div>
            <div class="tools-locked-body">
              <div class="tools-locked-name">{t.name}</div>
              <p class="tools-locked-desc">{t.desc}</p>
            </div>
            <div class="tools-locked-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              Subscribers only
            </div>
          </div>
        ))}
      </div>

      <div class="tools-sub-form">
        <div class="ml-embedded" data-form="d5CS8H"></div>
        <p class="tools-sub-note">No spam. Unsubscribe any time.</p>
      </div>
    </div>

    <div class="tools-bonus-section">
      <div class="tools-bonus-card">
        <div class="tools-bonus-icon">✂️</div>
        <div class="tools-bonus-body">
          <div class="tools-bonus-label">Book Bonus</div>
          <h2 class="tools-bonus-title">Stencil Creator</h2>
          <p class="tools-bonus-desc">Turn any photo into a print-ready, multi-layer cut stencil — draw freehand or use shapes and text, then export as PNG, PDF, or cut-ready SVG. Included <strong>free</strong> with The Airbrush Technique Bible.</p>
          <a href="/book/" class="abd-btn-primary">Get the Book — $27 →</a>
        </div>
      </div>
    </div>

  </main>
</BaseLayout>

<style>
.tools-subscriber-section {
  margin-top: 56px;
  padding-top: 40px;
  border-top: 1px solid var(--abd-border);
  margin-bottom: 80px;
}
.tools-sub-header {
  margin-bottom: 28px;
}
.tools-sub-label {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--abd-accent);
  margin-bottom: 8px;
}
.tools-sub-title {
  font-family: var(--abd-font-display);
  font-size: clamp(1.2rem, 2.5vw, 1.5rem);
  font-weight: 700;
  color: var(--abd-text);
  margin-bottom: 8px;
}
.tools-sub-desc {
  font-size: 0.92rem;
  color: var(--abd-text-dim);
  line-height: 1.6;
  max-width: 520px;
}
.tools-locked-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 16px;
  margin-bottom: 36px;
}
.tools-locked-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 20px 24px;
  background: var(--abd-surface);
  border: 1px solid var(--abd-border);
  border-radius: var(--abd-radius);
  opacity: 0.7;
}
.tools-locked-icon {
  font-size: 2rem;
  flex-shrink: 0;
}
.tools-locked-body {
  flex: 1;
}
.tools-locked-name {
  font-family: var(--abd-font-display);
  font-size: 1rem;
  font-weight: 700;
  color: var(--abd-text);
  margin-bottom: 6px;
}
.tools-locked-desc {
  font-size: 0.875rem;
  color: var(--abd-text-dim);
  line-height: 1.6;
}
.tools-locked-badge {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.72rem;
  color: var(--abd-text-muted);
  white-space: nowrap;
  flex-shrink: 0;
  padding-top: 2px;
}
.tools-sub-form {
  width: 100%;
}
.tools-sub-note {
  font-size: 0.72rem;
  color: var(--abd-text-muted);
  margin-top: 8px;
}
.tools-bonus-section {
  margin-bottom: 80px;
}
.tools-bonus-card {
  display: flex;
  align-items: flex-start;
  gap: 24px;
  padding: 32px;
  background: var(--abd-surface);
  border: 1px solid var(--abd-orange);
  border-radius: var(--abd-radius);
}
.tools-bonus-icon {
  font-size: 2.6rem;
  flex-shrink: 0;
}
.tools-bonus-body {
  flex: 1;
}
.tools-bonus-label {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--abd-orange);
  margin-bottom: 8px;
}
.tools-bonus-title {
  font-family: var(--abd-font-display);
  font-size: clamp(1.2rem, 2.5vw, 1.5rem);
  font-weight: 700;
  color: var(--abd-text);
  margin-bottom: 10px;
}
.tools-bonus-desc {
  font-size: 0.92rem;
  color: var(--abd-text-dim);
  line-height: 1.65;
  max-width: 560px;
  margin-bottom: 20px;
}
@media (max-width: 600px) {
  .tools-bonus-card { flex-direction: column; gap: 16px; }
}
</style>
