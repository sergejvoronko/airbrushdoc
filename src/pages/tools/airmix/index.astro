---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { buildWebAppSchema } from '../../../lib/schema';
import { buildBreadcrumbSchema } from '../../../lib/schema';

const appSchema = buildWebAppSchema({
  name: "AirMix Studio",
  description: "Paint ratio calculator, project logbook, needle and nozzle reference, and colour harmony tools.",
  path: "/tools/airmix/",
  free: true,
});
const crumbSchema = buildBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Tools', path: '/tools/' }, { name: 'AirMix' }]);

---
<BaseLayout
  title="AirMix — Airbrush Studio App | AirbrushDOC"
  description="Free browser-based airbrush studio: paint formulas, ratio calculator, project logbook, needle & nozzle reference and color harmony tools."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(appSchema)} />
  <main class="abd-container" style="padding-bottom: 0;">
    <div class="blg-page-header" style="margin-bottom: 20px;">
      <nav class="blg-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="blg-breadcrumbs-sep">›</span>
        <a href="/tools/">Tools</a>
        <span class="blg-breadcrumbs-sep">›</span>
        <span>AirMix</span>
      </nav>
      <div class="blg-title-row">
        <h1 class="blg-page-title">Air<span class="blg-page-title-accent">Mix</span></h1>
      </div>
      <p style="color: var(--abd-text-muted); font-size: 0.92rem; margin: 6px 0 0; max-width: 580px;">
        Your airbrush studio in the browser — paint formulas, ratio calculator, project logbook,
        needle &amp; nozzle reference, and color harmony. No account needed.
      </p>
      <div class="blg-header-line" style="margin-top: 16px;"></div>
    </div>
  
    <section class="tool-about">
      <h2>How to use the paint mixing calculator</h2>
      <p>Airbrush paint is thinned by ratio, not by eye, and the ratio changes with the paint
    type and the pressure you spray at. Enter the volume of paint you want in the cup and the
    tool works out how much reducer to add, so you can mix a repeatable batch instead of guessing
    each time.</p>
    <p>Two things worth knowing before you mix. Acrylics thinned past roughly 1:2 start to lose
    coverage and will need more passes, which is often what causes runs rather than the thinning
    itself. And reducer is not the same as water: dedicated reducer keeps the binder intact, while
    water dilutes it and can leave the film weak.</p>
      <p class="tool-about-next"><strong>Read next:</strong> <a href="/blog/how-to-thin-acrylic-paint-for-airbrush/">Exact thinning ratios by brand</a></p>
    </section>
  </main>

  <div class="airmix-frame-wrap">
    <iframe
      src="/tools/airmix.html"
      title="AirMix Airbrush Studio App"
      class="airmix-frame"
      allowfullscreen
    ></iframe>
  </div>
</BaseLayout>

<style>
.tool-about {
  max-width: 68ch;
  margin: 48px auto 0;
  padding: 28px 0 0;
  border-top: 1px solid var(--abd-border, #2a2a2a);
}
.tool-about h2 {
  font-family: var(--abd-font-display);
  font-size: 1.15rem;
  margin: 0 0 14px;
}
.tool-about p {
  color: var(--abd-text-dim);
  line-height: 1.75;
  margin: 0 0 14px;
}
.tool-about-next { margin-top: 18px; }

.airmix-frame-wrap {
  width: 100%;
  height: calc(100vh - 260px);
  min-height: 580px;
  border-top: 1px solid var(--abd-border);
}
.airmix-frame {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}
@media (max-width: 768px) {
  .airmix-frame-wrap {
    height: calc(100vh - 220px);
    min-height: 500px;
  }
}
</style>
