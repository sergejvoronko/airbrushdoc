---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildWebAppSchema } from '../../lib/schema';
import toolContent from '../../tools-content/quiz.html?raw';

const appSchema = buildWebAppSchema({
  name: "Airbrush Finder Quiz",
  description: "Answer six questions about your style, surface and budget to get an airbrush recommendation.",
  path: "/tools/airbrush-quiz/",
  free: true,
});
---
<BaseLayout title="Find Your Perfect Airbrush | AirbrushDOC" description="Answer 6 questions to discover the right airbrush for your style, surface, and budget.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(appSchema)} />
  <main class="abd-container" style="padding: 40px 24px 80px;">
    <nav class="abd-breadcrumbs" style="margin-bottom: 24px;">
      <a href="/">Home</a>
      <span class="abd-breadcrumbs-sep">›</span>
      <a href="/tools/">Tools</a>
      <span class="abd-breadcrumbs-sep">›</span>
      <span>Find Your Perfect Airbrush</span>
    </nav>
    <Fragment set:html={toolContent} />
  
    <section class="tool-about">
      <h2>What this quiz is for</h2>
      <p>A short set of questions about what you want to paint, how much you want to spend, and
    how much patience you have for cleaning. It ends with a shortlist rather than a single answer,
    because the right first airbrush depends more on the work than on the badge on the body.</p>
    <p>If you would rather skip the questions: a dual-action gravity-feed airbrush with a
    0.3&nbsp;mm needle suits nearly every beginner, and the money saved on a cheaper body is
    usually better spent on a compressor with a tank and a moisture trap.</p>
      <p class="tool-about-next"><strong>Read next:</strong> <a href="/blog/best-airbrush-for-beginners-2026/">Best Airbrush for Beginners 2026: 5 honest picks</a></p>
    </section>
  </main>
</BaseLayout>

<style>
.tool-about {
  max-width: 68ch;
  margin: 48px auto 0;
  padding: 28px 0 0;
  border-top: 1px solid var(--abd-border, #2a2a2a);
}
.tool-about h2 {
  font-family: var(--abd-font-display);
  font-size: 1.15rem;
  margin: 0 0 14px;
}
.tool-about p {
  color: var(--abd-text-dim);
  line-height: 1.75;
  margin: 0 0 14px;
}
.tool-about-next { margin-top: 18px; }
</style>
