---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact | AirbrushDOC"
  description="Get in touch with AirbrushDOC — questions, feedback, collaboration, or press enquiries."
>
  <main class="abd-container" style="max-width:780px;margin:0 auto;padding:48px 24px 80px;">
    <nav style="font-size:0.8rem;color:var(--abd-text-muted);margin-bottom:32px;">
      <a href="/" style="color:var(--abd-text-dim);text-decoration:none;">Home</a>
      <span style="margin:0 8px;">›</span>
      <span>Contact</span>
    </nav>

    <h1 style="font-family:var(--abd-font-display);font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;color:var(--abd-text);margin-bottom:12px;letter-spacing:-0.02em;">
      Get in Touch
    </h1>
    <p style="color:var(--abd-text-dim);font-size:0.95rem;line-height:1.7;margin-bottom:48px;max-width:560px;">
      Questions about airbrushing, feedback on an article, a collaboration idea, or something else entirely — drop us a line and we'll get back to you.
    </p>

    <div class="contact-layout">

      <form class="contact-form" id="contactForm" novalidate>
        <div class="contact-field">
          <label for="contact-name">Your name</label>
          <input type="text" id="contact-name" name="name" placeholder="Jane Smith" required />
        </div>
        <div class="contact-field">
          <label for="contact-email">Email address</label>
          <input type="email" id="contact-email" name="email" placeholder="you@example.com" required />
        </div>
        <div class="contact-field">
          <label for="contact-subject">Subject</label>
          <select id="contact-subject" name="subject">
            <option value="">Select a topic…</option>
            <option value="question">Airbrush question</option>
            <option value="feedback">Site feedback</option>
            <option value="collaboration">Collaboration / press</option>
            <option value="merchandise">Merchandise / order</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="contact-field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="6" placeholder="Tell us what's on your mind…" required></textarea>
        </div>
        <button type="submit" class="contact-submit abd-btn-primary" id="contactSubmit">
          Send Message
        </button>
        <div class="contact-status" id="contactStatus" aria-live="polite"></div>
      </form>

      <aside class="contact-aside">
        <div class="contact-info-card">
          <div class="contact-info-icon">✉️</div>
          <div class="contact-info-label">Email</div>
          <a href="mailto:info@airbrushdoc.com" class="contact-info-value">info@airbrushdoc.com</a>
          <p class="contact-info-note">We reply within 2–3 business days.</p>
        </div>

        <div class="contact-topics">
          <div class="contact-topics-label">Good reasons to write</div>
          <ul>
            <li>You have a question about a technique or product</li>
            <li>You spotted an error in one of our guides</li>
            <li>You'd like to contribute an article or gallery piece</li>
            <li>You have a merchandise or order issue</li>
            <li>You're interested in advertising or sponsorship</li>
          </ul>
        </div>

        <div class="contact-note">
          <p>For affiliate or cookie questions see the <a href="/affiliate-disclosure/">Affiliate Disclosure</a> page.</p>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
.contact-layout {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 48px;
  align-items: start;
}
@media (max-width: 700px) {
  .contact-layout { grid-template-columns: 1fr; }
  .contact-aside { order: -1; }
}

/* Form */
.contact-form { display: flex; flex-direction: column; gap: 20px; }
.contact-field { display: flex; flex-direction: column; gap: 6px; }
.contact-field label {
  font-size: 0.78rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.08em; color: var(--abd-text-dim);
}
.contact-field input,
.contact-field select,
.contact-field textarea {
  background: var(--abd-surface);
  border: 1px solid var(--abd-border);
  border-radius: var(--abd-radius-s);
  padding: 10px 14px;
  font-size: 0.9rem; color: var(--abd-text);
  font-family: inherit;
  transition: border-color 0.2s;
  width: 100%; box-sizing: border-box;
}
.contact-field input::placeholder,
.contact-field textarea::placeholder { color: var(--abd-text-muted); }
.contact-field input:focus,
.contact-field select:focus,
.contact-field textarea:focus {
  outline: none;
  border-color: var(--abd-orange);
  box-shadow: 0 0 0 3px rgba(244,103,26,0.12);
}
.contact-field select { appearance: none; cursor: pointer; }
.contact-field select option { background: var(--abd-surface2); color: var(--abd-text); }
.contact-field textarea { resize: vertical; min-height: 140px; line-height: 1.6; }
.contact-submit { align-self: flex-start; cursor: pointer; border: none; }
.contact-submit:disabled { opacity: 0.6; cursor: not-allowed; }
.contact-status {
  font-size: 0.85rem; line-height: 1.5; min-height: 20px;
}
.contact-status.success { color: var(--abd-green); }
.contact-status.error { color: #f87171; }

/* Aside */
.contact-aside { display: flex; flex-direction: column; gap: 20px; }
.contact-info-card {
  background: var(--abd-surface);
  border: 1px solid var(--abd-border);
  border-radius: var(--abd-radius);
  padding: 24px; text-align: center;
}
.contact-info-icon { font-size: 2rem; margin-bottom: 12px; }
.contact-info-label {
  font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.1em; color: var(--abd-text-muted); margin-bottom: 6px;
}
.contact-info-value {
  display: block; font-size: 0.9rem; font-weight: 600;
  color: var(--abd-orange); text-decoration: none; margin-bottom: 8px;
}
.contact-info-value:hover { text-decoration: underline; }
.contact-info-note { font-size: 0.78rem; color: var(--abd-text-muted); margin: 0; }

.contact-topics {
  background: var(--abd-surface);
  border: 1px solid var(--abd-border);
  border-radius: var(--abd-radius);
  padding: 20px;
}
.contact-topics-label {
  font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.1em; color: var(--abd-text-dim); margin-bottom: 12px;
}
.contact-topics ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.contact-topics li {
  font-size: 0.82rem; color: var(--abd-text-dim); line-height: 1.5;
  padding-left: 16px; position: relative;
}
.contact-topics li::before {
  content: '→'; position: absolute; left: 0;
  color: var(--abd-orange); font-size: 0.75rem;
}

.contact-note {
  font-size: 0.8rem; color: var(--abd-text-muted); line-height: 1.6;
  padding: 14px 16px;
  background: var(--abd-surface); border: 1px solid var(--abd-border);
  border-radius: var(--abd-radius-s);
}
.contact-note a { color: var(--abd-orange); text-decoration: none; }
.contact-note a:hover { text-decoration: underline; }
.contact-note p { margin: 0; }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const btn = document.getElementById('contactSubmit') as HTMLButtonElement | null;
  const status = document.getElementById('contactStatus');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
    if (status) { status.className = 'contact-status'; status.textContent = ''; }

    const data = new FormData(form);
    const body = {
      name: data.get('name'),
      email: data.get('email'),
      subject: data.get('subject') || 'Contact form',
      message: data.get('message'),
    };

    try {
      const res = await fetch('https://formspree.io/f/YOUR_FORM_ID', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(body),
      });
      if (res.ok) {
        if (status) { status.className = 'contact-status success'; status.textContent = 'Message sent — we\'ll get back to you within a couple of days.'; }
        form.reset();
      } else {
        throw new Error('Server error');
      }
    } catch {
      if (status) { status.className = 'contact-status error'; status.textContent = 'Something went wrong. Please email us directly at info@airbrushdoc.com'; }
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = 'Send Message'; }
    }
  });
</script>
