---
interface Props { faqs: { q: string; a: string }[]; }
const { faqs } = Astro.props;
---
{faqs.length > 0 && (
  <section class="abd-faq-section">
    <h2 class="abd-faq-title">Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <div class="abd-faq-item">
        <div class="abd-faq-q" role="button" tabindex="0">
          {faq.q}
          <svg class="abd-faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </div>
        <div class="abd-faq-a">{faq.a}</div>
      </div>
    ))}
  </section>
)}
