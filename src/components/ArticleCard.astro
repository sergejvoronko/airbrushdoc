---
interface Props {
  title: string;
  slug: string;
  description?: string;
  heroImage?: string;
  heroImageAlt?: string;
  category?: string;
  pubDate: Date;
  readingTime?: number;
}
const { title, slug, description, heroImage, heroImageAlt, category = 'general', pubDate, readingTime } = Astro.props;
const catLabel = category.charAt(0).toUpperCase() + category.slice(1).replace(/-/g, ' ');
const dateStr = pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---
<a href={`/blog/${slug}/`} class="abd-card">
  {heroImage && (
    <div class="abd-card-img">
      <img src={heroImage} alt={heroImageAlt || title} loading="lazy" />
    </div>
  )}
  <div class="abd-card-body">
    <div class="abd-card-cat">{catLabel}</div>
    <div class="abd-card-title">{title}</div>
    {description && <p class="abd-card-excerpt">{description}</p>}
    <div class="abd-card-meta">
      <span>{dateStr}</span>
      {readingTime && (
        <>
          <span class="abd-card-meta-dot"></span>
          <span>{readingTime} min</span>
        </>
      )}
    </div>
  </div>
</a>
