---
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings: Heading[]; }
const { headings } = Astro.props;
const filtered = headings.filter(h => h.depth <= 3);
---
{filtered.length > 0 && (
  <div class="abd-sidebar-widget">
    <div class="abd-sidebar-label">Contents</div>
    <ul class="abd-toc-list">
      {filtered.map(h => (
        <li style={h.depth === 3 ? 'padding-left:12px' : ''}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </div>
)}
